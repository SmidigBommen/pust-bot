{
  "display_information": {
    "name": "Pust",
    "description": "Bevegelsesglede og felles progresjon for Gnist",
    "background_color": "#173F35"
  },
  "features": {
    "bot_user": {
      "display_name": "Pust",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/pust",
        "description": "Registrer aktivitet og se fremdrift",
        "usage_hint": "logg | status | meg | hjelp",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
